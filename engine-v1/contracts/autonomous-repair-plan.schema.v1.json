{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-matchlab.autonomous-repair-plan.v1",
  "title": "AI MatchLab Autonomous Repair Plan V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "dayKey",
    "generatedAt",
    "role",
    "bindings",
    "planFingerprint",
    "planState",
    "summary",
    "candidateDecisionIds",
    "operations",
    "blockers",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "ai-matchlab.autonomous-repair-plan.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "dayKey": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "const": "derived_dry_run_repair_plan"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truthFingerprint",
        "auditFingerprint",
        "downstreamEvidenceFingerprint",
        "primaryEvidenceFingerprint",
        "policyFingerprint",
        "verificationFingerprint",
        "gateFingerprint"
      ],
      "properties": {
        "truthFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "auditFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "downstreamEvidenceFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "primaryEvidenceFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policyFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verificationFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "gateFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "planFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "planState": {
      "enum": [
        "NO_ACTION_NOT_REQUESTABLE",
        "NO_ACTION_UPSTREAM_DENIED",
        "DRY_RUN_READY",
        "BLOCKED_TARGET_CONTRACT"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateCount",
        "operationCount",
        "createCount",
        "replaceCount",
        "blockerCount"
      ],
      "properties": {
        "candidateCount": {
          "type": "integer",
          "minimum": 0
        },
        "operationCount": {
          "type": "integer",
          "minimum": 0
        },
        "createCount": {
          "type": "integer",
          "minimum": 0
        },
        "replaceCount": {
          "type": "integer",
          "minimum": 0
        },
        "blockerCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "candidateDecisionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^arpd_v1_[0-9a-f]{24}$"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "candidateDecisionId",
          "repairClass",
          "canonicalId",
          "targetPath",
          "mutationMode",
          "precondition",
          "planned",
          "rollback"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "pattern": "^arpo_v1_[0-9a-f]{24}$"
          },
          "candidateDecisionId": {
            "type": "string",
            "pattern": "^arpd_v1_[0-9a-f]{24}$"
          },
          "repairClass": {
            "enum": [
              "ACQUIRE_VERIFIED_FINAL_EVIDENCE",
              "REBUILD_HISTORY_ELIGIBLE_ROW",
              "REBUILD_PUBLICATION_CANONICAL_ROW"
            ]
          },
          "canonicalId": {
            "type": "string",
            "minLength": 1
          },
          "targetPath": {
            "type": "string",
            "minLength": 1
          },
          "mutationMode": {
            "enum": [
              "CREATE",
              "REPLACE"
            ]
          },
          "precondition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "targetExists",
              "expectedSha256"
            ],
            "properties": {
              "targetExists": {
                "type": "boolean"
              },
              "expectedSha256": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "planned": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contentSha256",
              "contentBytes"
            ],
            "properties": {
              "contentSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "contentBytes": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "rollback": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "strategy",
              "preimageRequired",
              "preimageSha256"
            ],
            "properties": {
              "strategy": {
                "enum": [
                  "DELETE_CREATED_TARGET",
                  "RESTORE_PREIMAGE"
                ]
              },
              "preimageRequired": {
                "type": "boolean"
              },
              "preimageSha256": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "candidateDecisionId",
          "targetPath"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "candidateDecisionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "targetPath": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dryRunOnly",
        "filesystemWriteAuthorized",
        "repairAuthorized",
        "executionAuthorized",
        "rollbackExecutionAuthorized",
        "workflowMutationAuthorized"
      ],
      "properties": {
        "dryRunOnly": {
          "const": true
        },
        "filesystemWriteAuthorized": {
          "const": false
        },
        "repairAuthorized": {
          "const": false
        },
        "executionAuthorized": {
          "const": false
        },
        "rollbackExecutionAuthorized": {
          "const": false
        },
        "workflowMutationAuthorized": {
          "const": false
        }
      }
    }
  }
}
