{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-matchlab.autonomous-repair-policy-day.v1",
  "title": "AI MatchLab Autonomous Repair Policy Day V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "dayKey",
    "generatedAt",
    "role",
    "truthFingerprint",
    "auditFingerprint",
    "downstreamEvidenceFingerprint",
    "primaryEvidenceFingerprint",
    "policyFingerprint",
    "policyState",
    "summary",
    "decisions",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "ai-matchlab.autonomous-repair-policy-day.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "dayKey": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "const": "derived_daily_repair_policy"
    },
    "truthFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "auditFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "downstreamEvidenceFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "primaryEvidenceFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policyFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policyState": {
      "enum": [
        "CLEAR",
        "OBSERVATION_ONLY",
        "CANDIDATES_PRESENT",
        "QUARANTINED",
        "BLOCKED"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionCount",
        "observationOnlyCount",
        "candidateCount",
        "quarantineCount",
        "hardBlockCount",
        "suppressedGenericAuditCount",
        "repairClassCounts"
      ],
      "properties": {
        "decisionCount": {
          "type": "integer",
          "minimum": 0
        },
        "observationOnlyCount": {
          "type": "integer",
          "minimum": 0
        },
        "candidateCount": {
          "type": "integer",
          "minimum": 0
        },
        "quarantineCount": {
          "type": "integer",
          "minimum": 0
        },
        "hardBlockCount": {
          "type": "integer",
          "minimum": 0
        },
        "suppressedGenericAuditCount": {
          "type": "integer",
          "minimum": 0
        },
        "repairClassCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ACQUIRE_VERIFIED_FINAL_EVIDENCE",
            "REBUILD_HISTORY_ELIGIBLE_ROW",
            "REBUILD_PUBLICATION_CANONICAL_ROW"
          ],
          "properties": {
            "ACQUIRE_VERIFIED_FINAL_EVIDENCE": {
              "type": "integer",
              "minimum": 0
            },
            "REBUILD_HISTORY_ELIGIBLE_ROW": {
              "type": "integer",
              "minimum": 0
            },
            "REBUILD_PUBLICATION_CANONICAL_ROW": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "autonomous-repair-policy-decision.schema.v1.json"
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateSelectionOnly",
        "filesystemWriteAuthorized",
        "repairAuthorized",
        "executionAuthorized",
        "workflowMutationAuthorized"
      ],
      "properties": {
        "candidateSelectionOnly": {
          "const": true
        },
        "filesystemWriteAuthorized": {
          "const": false
        },
        "repairAuthorized": {
          "const": false
        },
        "executionAuthorized": {
          "const": false
        },
        "workflowMutationAuthorized": {
          "const": false
        }
      }
    }
  }
}
