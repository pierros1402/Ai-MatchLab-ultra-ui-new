{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-matchlab.local/contracts/day-truth-ledger.schema.v1.json",
  "title": "AI MatchLab Day Truth Ledger V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ledgerVersion",
    "dayKey",
    "generatedAt",
    "role",
    "ledgerState",
    "truthFingerprint",
    "authority",
    "summary",
    "fixtures",
    "anomalies",
    "downstream",
    "provenance",
    "authorization"
  ],
  "properties": {
    "schema": {
      "const": "ai-matchlab.day-truth-ledger.v1"
    },
    "ledgerVersion": {
      "const": "1.0.0"
    },
    "dayKey": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "role": {
      "const": "derived_control_plane"
    },
    "ledgerState": {
      "enum": [
        "EMPTY",
        "OPEN",
        "INCOMPLETE",
        "CLOSED",
        "CONFLICT"
      ]
    },
    "truthFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "membership",
        "operationalState",
        "scoredFinalEvidence",
        "historyEligibility",
        "scoredSettlementEligibility",
        "voidSettlementEligibility",
        "downstreamProjections"
      ],
      "properties": {
        "membership": {
          "const": "canonical_fixtures"
        },
        "operationalState": {
          "const": "canonical_fixtures_via_unified_match_state_contract"
        },
        "scoredFinalEvidence": {
          "const": "verified_final_results"
        },
        "historyEligibility": {
          "const": "canonical_played_terminal_plus_verified_final"
        },
        "scoredSettlementEligibility": {
          "const": "canonical_played_terminal_plus_verified_final"
        },
        "voidSettlementEligibility": {
          "const": "canonical_non_played_terminal_contract"
        },
        "downstreamProjections": {
          "const": "non_authoritative_observations"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalRows",
        "playedTerminal",
        "nonPlayedTerminal",
        "scheduled",
        "live",
        "interrupted",
        "delayed",
        "operationalConflict",
        "operationalUnresolved",
        "verifiedFinalArtifacts",
        "acceptedVerifiedFinalArtifacts",
        "convergedPlayedFinal",
        "convergedNonPlayedTerminal",
        "pendingVerifiedFinal",
        "openRows",
        "unresolvedRows",
        "conflictRows",
        "orphanVerifiedFinals",
        "duplicateVerifiedFinalFixtureIds",
        "historyEligible",
        "scoredSettlementEligible",
        "voidSettlementEligible"
      ],
      "properties": {
        "canonicalRows": {
          "type": "integer",
          "minimum": 0
        },
        "playedTerminal": {
          "type": "integer",
          "minimum": 0
        },
        "nonPlayedTerminal": {
          "type": "integer",
          "minimum": 0
        },
        "scheduled": {
          "type": "integer",
          "minimum": 0
        },
        "live": {
          "type": "integer",
          "minimum": 0
        },
        "interrupted": {
          "type": "integer",
          "minimum": 0
        },
        "delayed": {
          "type": "integer",
          "minimum": 0
        },
        "operationalConflict": {
          "type": "integer",
          "minimum": 0
        },
        "operationalUnresolved": {
          "type": "integer",
          "minimum": 0
        },
        "verifiedFinalArtifacts": {
          "type": "integer",
          "minimum": 0
        },
        "acceptedVerifiedFinalArtifacts": {
          "type": "integer",
          "minimum": 0
        },
        "convergedPlayedFinal": {
          "type": "integer",
          "minimum": 0
        },
        "convergedNonPlayedTerminal": {
          "type": "integer",
          "minimum": 0
        },
        "pendingVerifiedFinal": {
          "type": "integer",
          "minimum": 0
        },
        "openRows": {
          "type": "integer",
          "minimum": 0
        },
        "unresolvedRows": {
          "type": "integer",
          "minimum": 0
        },
        "conflictRows": {
          "type": "integer",
          "minimum": 0
        },
        "orphanVerifiedFinals": {
          "type": "integer",
          "minimum": 0
        },
        "duplicateVerifiedFinalFixtureIds": {
          "type": "integer",
          "minimum": 0
        },
        "historyEligible": {
          "type": "integer",
          "minimum": 0
        },
        "scoredSettlementEligible": {
          "type": "integer",
          "minimum": 0
        },
        "voidSettlementEligible": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonicalId",
          "leagueSlug",
          "homeTeam",
          "awayTeam",
          "kickoffUtc",
          "baseState",
          "operationalState",
          "canonical",
          "verifiedFinal",
          "decision",
          "downstream"
        ],
        "properties": {
          "canonicalId": {
            "type": "string",
            "minLength": 1
          },
          "leagueSlug": {
            "type": [
              "string",
              "null"
            ]
          },
          "homeTeam": {
            "type": [
              "string",
              "null"
            ]
          },
          "awayTeam": {
            "type": [
              "string",
              "null"
            ]
          },
          "kickoffUtc": {
            "type": [
              "string",
              "null"
            ]
          },
          "baseState": {
            "enum": [
              "PRE_KICKOFF_SCHEDULED",
              "PRE_KICKOFF_NON_PLAYED",
              "PLAY_INTERRUPTED",
              "TEMPORARY_DELAY",
              "RESULT_INVALIDATED",
              "PLAYED_FINAL",
              "CONFLICT",
              "UNKNOWN"
            ]
          },
          "operationalState": {
            "enum": [
              "PLAYED_TERMINAL",
              "NON_PLAYED_TERMINAL",
              "LIVE",
              "SCHEDULED",
              "INTERRUPTED",
              "DELAYED",
              "CONFLICT",
              "UNRESOLVED"
            ]
          },
          "canonical": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "statusType",
              "rawStatus",
              "scoreHome",
              "scoreAway"
            ],
            "properties": {
              "status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "statusType": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rawStatus": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "scoreHome": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "scoreAway": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "verifiedFinal": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "present",
              "accepted",
              "reason",
              "verdict",
              "dayKey",
              "scoreHome",
              "scoreAway",
              "scoreParity"
            ],
            "properties": {
              "present": {
                "type": "boolean"
              },
              "accepted": {
                "type": "boolean"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "verdict": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "dayKey": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "scoreHome": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "scoreAway": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "scoreParity": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          },
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "reason",
              "operationallyClosed",
              "historyEligible",
              "scoredSettlementEligible",
              "voidSettlementEligible",
              "repairAuthorized"
            ],
            "properties": {
              "status": {
                "enum": [
                  "CONVERGED_PLAYED_FINAL",
                  "CONVERGED_NON_PLAYED_TERMINAL",
                  "PENDING_VERIFIED_FINAL",
                  "OPEN",
                  "UNRESOLVED",
                  "CONFLICT"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "operationallyClosed": {
                "type": "boolean"
              },
              "historyEligible": {
                "type": "boolean"
              },
              "scoredSettlementEligible": {
                "type": "boolean"
              },
              "voidSettlementEligible": {
                "type": "boolean"
              },
              "repairAuthorized": {
                "const": false
              }
            }
          },
          "downstream": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "history",
              "settlement",
              "publication"
            ],
            "properties": {
              "history": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "observed",
                  "present"
                ],
                "properties": {
                  "observed": {
                    "type": "boolean"
                  },
                  "present": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                }
              },
              "settlement": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "observed",
                  "state"
                ],
                "properties": {
                  "observed": {
                    "type": "boolean"
                  },
                  "state": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "publication": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "observed",
                  "present"
                ],
                "properties": {
                  "observed": {
                    "type": "boolean"
                  },
                  "present": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "anomalies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orphanVerifiedFinals",
        "duplicateVerifiedFinalFixtureIds",
        "conflictFixtureIds",
        "pendingVerifiedFinalFixtureIds"
      ],
      "properties": {
        "orphanVerifiedFinals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "canonicalId",
              "reason"
            ],
            "properties": {
              "canonicalId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "duplicateVerifiedFinalFixtureIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "conflictFixtureIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "pendingVerifiedFinalFixtureIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "downstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historyObserved",
        "settlementObserved",
        "publicationObserved",
        "systemHealthObserved",
        "systemHealth",
        "convergence"
      ],
      "properties": {
        "historyObserved": {
          "type": "boolean"
        },
        "settlementObserved": {
          "type": "boolean"
        },
        "publicationObserved": {
          "type": "boolean"
        },
        "systemHealthObserved": {
          "type": "boolean"
        },
        "systemHealth": {
          "type": [
            "object",
            "null"
          ]
        },
        "convergence": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "overallState",
                "truthFingerprint",
                "history",
                "settlement",
                "publication",
                "systemHealth",
                "authority"
              ],
              "properties": {
                "overallState": {
                  "enum": [
                    "NOT_OBSERVED",
                    "PARTIALLY_OBSERVED",
                    "CONVERGED",
                    "INCOMPLETE",
                    "CONFLICT"
                  ]
                },
                "truthFingerprint": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "history": {
                  "type": "object"
                },
                "settlement": {
                  "type": "object"
                },
                "publication": {
                  "type": "object"
                },
                "systemHealth": {
                  "type": "object"
                },
                "authority": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "footballTruthMutable",
                    "downstreamMutationAuthorized",
                    "repairAuthorized",
                    "observationsAffectTruthFingerprint"
                  ],
                  "properties": {
                    "footballTruthMutable": {
                      "const": false
                    },
                    "downstreamMutationAuthorized": {
                      "const": false
                    },
                    "repairAuthorized": {
                      "const": false
                    },
                    "observationsAffectTruthFingerprint": {
                      "const": false
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "provenance": {
      "type": "object"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalWriteAuthorized",
        "verifiedFinalWriteAuthorized",
        "historyWriteAuthorized",
        "valueSettlementWriteAuthorized",
        "publicationWriteAuthorized",
        "repairAuthorized"
      ],
      "properties": {
        "canonicalWriteAuthorized": {
          "const": false
        },
        "verifiedFinalWriteAuthorized": {
          "const": false
        },
        "historyWriteAuthorized": {
          "const": false
        },
        "valueSettlementWriteAuthorized": {
          "const": false
        },
        "publicationWriteAuthorized": {
          "const": false
        },
        "repairAuthorized": {
          "const": false
        }
      }
    }
  }
}
