{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-matchlab.autonomous-repair-target-verification.v1",
  "title": "AI MatchLab Autonomous Repair Target Verification V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "dayKey",
    "generatedAt",
    "role",
    "planFingerprint",
    "verificationFingerprint",
    "verificationState",
    "summary",
    "operations",
    "blockers",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "ai-matchlab.autonomous-repair-target-verification.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "dayKey": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "const": "derived_read_only_target_preimage_verification"
    },
    "planFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verificationFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verificationState": {
      "enum": [
        "NO_ACTION_NO_OPERATIONS",
        "TARGETS_VERIFIED",
        "BLOCKED_TARGET_PREIMAGE"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationCount",
        "verifiedOperationCount",
        "blockedOperationCount",
        "createCount",
        "replaceCount",
        "blockerCount"
      ],
      "properties": {
        "operationCount": {
          "type": "integer",
          "minimum": 0
        },
        "verifiedOperationCount": {
          "type": "integer",
          "minimum": 0
        },
        "blockedOperationCount": {
          "type": "integer",
          "minimum": 0
        },
        "createCount": {
          "type": "integer",
          "minimum": 0
        },
        "replaceCount": {
          "type": "integer",
          "minimum": 0
        },
        "blockerCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "targetPath",
          "mutationMode",
          "lexicalContained",
          "physicalContained",
          "reparseFree",
          "parentChainVerified",
          "targetExists",
          "actualSha256",
          "actualBytes",
          "preconditionMatches",
          "preimageFingerprint",
          "verified"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "pattern": "^arpo_v1_[0-9a-f]{24}$"
          },
          "targetPath": {
            "type": "string",
            "minLength": 1
          },
          "mutationMode": {
            "enum": [
              "CREATE",
              "REPLACE"
            ]
          },
          "lexicalContained": {
            "type": "boolean"
          },
          "physicalContained": {
            "type": "boolean"
          },
          "reparseFree": {
            "type": "boolean"
          },
          "parentChainVerified": {
            "type": "boolean"
          },
          "targetExists": {
            "type": "boolean"
          },
          "actualSha256": {
            "type": [
              "string",
              "null"
            ]
          },
          "actualBytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "preconditionMatches": {
            "type": "boolean"
          },
          "preimageFingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "verified": {
            "type": "boolean"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "operationId",
          "targetPath"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "operationId": {
            "type": [
              "string",
              "null"
            ]
          },
          "targetPath": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readOnly",
        "filesystemWriteAuthorized",
        "repairAuthorized",
        "executionAuthorized",
        "rollbackExecutionAuthorized",
        "workflowMutationAuthorized"
      ],
      "properties": {
        "readOnly": {
          "const": true
        },
        "filesystemWriteAuthorized": {
          "const": false
        },
        "repairAuthorized": {
          "const": false
        },
        "executionAuthorized": {
          "const": false
        },
        "rollbackExecutionAuthorized": {
          "const": false
        },
        "workflowMutationAuthorized": {
          "const": false
        }
      }
    }
  }
}
