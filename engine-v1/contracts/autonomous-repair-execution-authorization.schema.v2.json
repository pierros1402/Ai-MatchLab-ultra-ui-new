{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-matchlab.autonomous-repair-execution-authorization.v2",
  "title": "AI MatchLab Autonomous Repair Execution Authorization V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "dayKey",
    "generatedAt",
    "role",
    "authorizationId",
    "nonce",
    "issuedAt",
    "notBefore",
    "expiresAt",
    "policyVersion",
    "authorizationState",
    "authorizationBasis",
    "bindings",
    "repairClassScope",
    "operationScope",
    "safety",
    "authority",
    "authorizationFingerprint",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "ai-matchlab.autonomous-repair-execution-authorization.v2"
    },
    "version": {
      "const": "2.0.0"
    },
    "dayKey": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "role": {
      "const": "externally_signed_bounded_execution_authorization"
    },
    "authorizationId": {
      "type": "string",
      "pattern": "^arauth_v2_[0-9a-f]{32}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^arnonce_v2_[0-9a-f]{64}$"
    },
    "issuedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "notBefore": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "expiresAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "policyVersion": {
      "const": "ai-matchlab.autonomous-repair-execution-policy.v1"
    },
    "authorizationState": {
      "enum": [
        "AUTHORIZED",
        "DENIED"
      ]
    },
    "authorizationBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "issuerId",
        "keyId",
        "publicKeySpkiSha256",
        "decisionFingerprint"
      ],
      "properties": {
        "source": {
          "const": "external_control_plane"
        },
        "issuerId": {
          "type": "string",
          "minLength": 1
        },
        "keyId": {
          "type": "string",
          "pattern": "^arkey_v1_[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "publicKeySpkiSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "decisionFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestFingerprint",
        "planFingerprint",
        "verificationFingerprint",
        "materialResolutionFingerprint"
      ],
      "properties": {
        "requestFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "planFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verificationFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "materialResolutionFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "repairClassScope": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "ACQUIRE_VERIFIED_FINAL_EVIDENCE",
          "REBUILD_HISTORY_ELIGIBLE_ROW",
          "REBUILD_PUBLICATION_CANONICAL_ROW"
        ]
      }
    },
    "operationScope": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "targetPath",
          "mutationMode",
          "preimageFingerprint",
          "repairClass"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "pattern": "^arpo_v1_[0-9a-f]{24}$"
          },
          "targetPath": {
            "type": "string",
            "minLength": 1
          },
          "mutationMode": {
            "enum": [
              "CREATE",
              "REPLACE"
            ]
          },
          "preimageFingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "repairClass": {
            "enum": [
              "ACQUIRE_VERIFIED_FINAL_EVIDENCE",
              "REBUILD_HISTORY_ELIGIBLE_ROW",
              "REBUILD_PUBLICATION_CANONICAL_ROW"
            ]
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exactRequestScopeOnly",
        "preimageReverificationRequired",
        "atomicWriteRequired",
        "postWriteAuditRequired",
        "rollbackRequired",
        "singleUseRequired"
      ],
      "properties": {
        "exactRequestScopeOnly": {
          "const": true
        },
        "preimageReverificationRequired": {
          "const": true
        },
        "atomicWriteRequired": {
          "const": true
        },
        "postWriteAuditRequired": {
          "const": true
        },
        "rollbackRequired": {
          "const": true
        },
        "singleUseRequired": {
          "const": true
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactReadOnly",
        "authorizationGranted",
        "filesystemWriteAuthorized",
        "repairAuthorized",
        "executionAuthorized",
        "rollbackExecutionAuthorized",
        "workflowMutationAuthorized"
      ],
      "properties": {
        "artifactReadOnly": {
          "const": true
        },
        "authorizationGranted": {
          "type": "boolean"
        },
        "filesystemWriteAuthorized": {
          "type": "boolean"
        },
        "repairAuthorized": {
          "type": "boolean"
        },
        "executionAuthorized": {
          "type": "boolean"
        },
        "rollbackExecutionAuthorized": {
          "type": "boolean"
        },
        "workflowMutationAuthorized": {
          "const": false
        }
      }
    },
    "authorizationFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "encoding",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "encoding": {
          "const": "base64"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
