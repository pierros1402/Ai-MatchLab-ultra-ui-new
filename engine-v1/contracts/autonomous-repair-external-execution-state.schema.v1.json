{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-matchlab.autonomous-repair-external-execution-state.v1",
  "title": "AI MatchLab Autonomous Repair External Execution State V1",
  "oneOf": [
    {
      "$ref": "#/$defs/journal"
    },
    {
      "$ref": "#/$defs/audit"
    },
    {
      "$ref": "#/$defs/lock"
    },
    {
      "$ref": "#/$defs/replayConsumption"
    }
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "transactionId": {
      "type": "string",
      "pattern": "^artxn_v1_[0-9a-f]{32}$"
    },
    "operationState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "targetPath",
        "mutationMode",
        "preimage",
        "postimage",
        "rollback",
        "backup",
        "temp",
        "applied",
        "restored"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^arpo_v1_[0-9a-f]{24}$"
        },
        "targetPath": {
          "type": "string",
          "minLength": 1
        },
        "mutationMode": {
          "enum": [
            "CREATE",
            "REPLACE"
          ]
        },
        "preimage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetExists",
            "sha256",
            "bytes",
            "preimageFingerprint"
          ],
          "properties": {
            "targetExists": {
              "type": "boolean"
            },
            "sha256": {
              "type": [
                "string",
                "null"
              ]
            },
            "bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "preimageFingerprint": {
              "$ref": "#/$defs/sha"
            }
          }
        },
        "postimage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contentSha256",
            "contentBytes"
          ],
          "properties": {
            "contentSha256": {
              "$ref": "#/$defs/sha"
            },
            "contentBytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "rollback": {
          "enum": [
            "DELETE_CREATED_TARGET",
            "RESTORE_PREIMAGE"
          ]
        },
        "backup": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "bytes"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "$ref": "#/$defs/sha"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "temp": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "bytes"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "$ref": "#/$defs/sha"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          ]
        },
        "applied": {
          "type": "boolean"
        },
        "restored": {
          "type": "boolean"
        }
      }
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "transactionId",
        "dayKey",
        "authorizationId",
        "authorizationFingerprint",
        "replayKey",
        "transactionFingerprint",
        "state",
        "updatedAt",
        "operations",
        "journalFingerprint"
      ],
      "properties": {
        "schema": {
          "const": "ai-matchlab.autonomous-repair-execution-journal.v1"
        },
        "version": {
          "const": "1.0.0"
        },
        "transactionId": {
          "$ref": "#/$defs/transactionId"
        },
        "dayKey": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "authorizationId": {
          "type": "string",
          "pattern": "^arauth_v2_[0-9a-f]{32}$"
        },
        "authorizationFingerprint": {
          "$ref": "#/$defs/sha"
        },
        "replayKey": {
          "$ref": "#/$defs/sha"
        },
        "transactionFingerprint": {
          "$ref": "#/$defs/sha"
        },
        "state": {
          "enum": [
            "PREPARED",
            "ABORTED_PRE_CONSUME",
            "REPLAY_CONSUMED",
            "BACKUPS_VERIFIED",
            "TEMPS_VERIFIED",
            "APPLYING",
            "POSTIMAGES_VERIFIED",
            "COMMITTED",
            "ROLLING_BACK",
            "ROLLED_BACK",
            "RECOVERY_REQUIRED"
          ]
        },
        "updatedAt": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operationState"
          }
        },
        "journalFingerprint": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "transactionId",
        "dayKey",
        "authorizationId",
        "authorizationFingerprint",
        "replayKey",
        "transactionFingerprint",
        "terminalState",
        "completedAt",
        "journalFingerprint",
        "operationCount",
        "auditFingerprint"
      ],
      "properties": {
        "schema": {
          "const": "ai-matchlab.autonomous-repair-execution-audit.v1"
        },
        "version": {
          "const": "1.0.0"
        },
        "transactionId": {
          "$ref": "#/$defs/transactionId"
        },
        "dayKey": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "authorizationId": {
          "type": "string",
          "pattern": "^arauth_v2_[0-9a-f]{32}$"
        },
        "authorizationFingerprint": {
          "$ref": "#/$defs/sha"
        },
        "replayKey": {
          "$ref": "#/$defs/sha"
        },
        "transactionFingerprint": {
          "$ref": "#/$defs/sha"
        },
        "terminalState": {
          "enum": [
            "ABORTED_PRE_CONSUME",
            "COMMITTED",
            "ROLLED_BACK",
            "RECOVERY_REQUIRED"
          ]
        },
        "completedAt": {
          "type": "string",
          "minLength": 1
        },
        "journalFingerprint": {
          "$ref": "#/$defs/sha"
        },
        "operationCount": {
          "type": "integer",
          "minimum": 1
        },
        "auditFingerprint": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "transactionId",
        "authorizationId",
        "transactionFingerprint",
        "acquiredAt"
      ],
      "properties": {
        "schema": {
          "const": "ai-matchlab.autonomous-repair-execution-lock.v1"
        },
        "version": {
          "const": "1.0.0"
        },
        "transactionId": {
          "$ref": "#/$defs/transactionId"
        },
        "authorizationId": {
          "type": "string",
          "pattern": "^arauth_v2_[0-9a-f]{32}$"
        },
        "transactionFingerprint": {
          "$ref": "#/$defs/sha"
        },
        "acquiredAt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "replayConsumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "replayKey",
        "authorizationId",
        "authorizationFingerprint",
        "transactionId",
        "consumedAt"
      ],
      "properties": {
        "schema": {
          "const": "ai-matchlab.autonomous-repair-replay-consumption.v1"
        },
        "version": {
          "const": "1.0.0"
        },
        "replayKey": {
          "$ref": "#/$defs/sha"
        },
        "authorizationId": {
          "type": "string",
          "pattern": "^arauth_v2_[0-9a-f]{32}$"
        },
        "authorizationFingerprint": {
          "$ref": "#/$defs/sha"
        },
        "transactionId": {
          "$ref": "#/$defs/transactionId"
        },
        "consumedAt": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
