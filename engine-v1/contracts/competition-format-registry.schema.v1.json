{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-matchlab.local/contracts/competition-format-registry.schema.v1.json",
  "title": "AI MatchLab Competition Format Registry V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "registryVersion",
    "generatedAt",
    "status",
    "policy",
    "coverage",
    "contracts"
  ],
  "properties": {
    "schema": {
      "const": "ai-matchlab.competition-format-registry.v1"
    },
    "registryVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "PARTIAL_AUTHORITY_READ_ONLY",
        "PRODUCTION_AUTHORITY_READ_ONLY",
        "RETIRED"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readOnlyValidation",
        "mutationAllowed",
        "unverifiedContractMode",
        "verifiedContractMode"
      ],
      "properties": {
        "readOnlyValidation": {
          "const": true
        },
        "mutationAllowed": {
          "const": false
        },
        "unverifiedContractMode": {
          "const": "REPORT_ONLY"
        },
        "verifiedContractMode": {
          "const": "STRICT_REPORT_ONLY"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractCount",
        "enabledContractCount",
        "disabledContractCount",
        "teamCountAuthorityCount",
        "phaseAuthorityCount",
        "unverifiedContractCount"
      ],
      "properties": {
        "contractCount": {
          "type": "integer",
          "minimum": 0
        },
        "enabledContractCount": {
          "type": "integer",
          "minimum": 0
        },
        "disabledContractCount": {
          "type": "integer",
          "minimum": 0
        },
        "teamCountAuthorityCount": {
          "type": "integer",
          "minimum": 0
        },
        "phaseAuthorityCount": {
          "type": "integer",
          "minimum": 0
        },
        "unverifiedContractCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract"
      }
    }
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "authorityScope": {
      "enum": [
        "TEAM_COUNT",
        "PHASE_STRUCTURE",
        "PROMOTION_RELEGATION",
        "CONTINENTAL_QUALIFICATION",
        "TIE_BREAK_RULES",
        "SEASON_CALENDAR"
      ]
    },
    "countRule": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "mode",
        "value",
        "minimum",
        "maximum"
      ],
      "properties": {
        "mode": {
          "enum": [
            "EXACT",
            "RANGE",
            "UNVERIFIED"
          ]
        },
        "value": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2
        },
        "minimum": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2
        },
        "maximum": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "required",
        "participantScope",
        "teamCount",
        "authority"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "required": {
          "type": "boolean"
        },
        "participantScope": {
          "enum": [
            "FULL_COMPETITION",
            "SUBSET",
            "INDEPENDENT_GROUP"
          ]
        },
        "teamCount": {
          "$ref": "#/$defs/countRule"
        },
        "authority": {
          "enum": [
            "VERIFIED",
            "OBSERVED_ONLY",
            "UNVERIFIED"
          ]
        }
      }
    },
    "partitionGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phaseKeys",
        "requireDisjoint",
        "coversPrimaryUniverse",
        "expectedUnionTeamCount"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "phaseKeys": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        },
        "requireDisjoint": {
          "type": "boolean"
        },
        "coversPrimaryUniverse": {
          "type": "boolean"
        },
        "expectedUnionTeamCount": {
          "$ref": "#/$defs/countRule"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceClass",
        "publisher",
        "title",
        "url",
        "retrievedAt",
        "supports"
      ],
      "properties": {
        "sourceClass": {
          "enum": [
            "PRIMARY_OFFICIAL",
            "PRIMARY_REGULATION",
            "TRUSTED_SECONDARY",
            "AGGREGATOR",
            "ENCYCLOPEDIA"
          ]
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date"
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/authorityScope"
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "contractVersion",
        "competition",
        "season",
        "authority",
        "teamCount",
        "tableModel",
        "rules",
        "provenance"
      ],
      "properties": {
        "contractId": {
          "type": "string",
          "pattern": "^[a-z0-9]+\\.[0-9]+@[0-9]{4}(?:-[0-9]{4})?#v[1-9][0-9]*$"
        },
        "contractVersion": {
          "type": "integer",
          "minimum": 1
        },
        "competition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "slug",
            "name",
            "country",
            "region",
            "kind",
            "enabled",
            "coverageTier"
          ],
          "properties": {
            "slug": {
              "type": "string",
              "pattern": "^[a-z0-9]+\\.[0-9]+$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "country": {
              "type": "string",
              "minLength": 1
            },
            "region": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "DOMESTIC_LEAGUE"
            },
            "enabled": {
              "type": "boolean"
            },
            "coverageTier": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "season": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference",
            "model",
            "validFrom",
            "validTo"
          ],
          "properties": {
            "reference": {
              "type": "string",
              "pattern": "^[0-9]{4}(?:-[0-9]{4})?$"
            },
            "model": {
              "enum": [
                "CALENDAR_YEAR",
                "CROSS_YEAR",
                "UNKNOWN"
              ]
            },
            "validFrom": {
              "$ref": "#/$defs/nullableString"
            },
            "validTo": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "scopes",
            "verifiedAt",
            "evidence"
          ],
          "properties": {
            "status": {
              "enum": [
                "PARTIALLY_VERIFIED",
                "VERIFIED",
                "UNVERIFIED",
                "NO_BASELINE"
              ]
            },
            "scopes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/authorityScope"
              }
            },
            "verifiedAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/evidence"
              }
            }
          }
        },
        "teamCount": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule",
            "enforcement",
            "sourceLabel"
          ],
          "properties": {
            "rule": {
              "$ref": "#/$defs/countRule"
            },
            "enforcement": {
              "enum": [
                "STRICT_REPORT_ONLY",
                "REPORT_ONLY",
                "NOT_EVALUATED"
              ]
            },
            "sourceLabel": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "tableModel": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "format",
            "primaryTableSource",
            "allowUnknownPhaseKeys",
            "phases",
            "partitionGroups"
          ],
          "properties": {
            "format": {
              "enum": [
                "SINGLE_TABLE",
                "PHASE_SPLIT",
                "UNKNOWN"
              ]
            },
            "primaryTableSource": {
              "enum": [
                "TABLE",
                "PHASE_UNION",
                "UNKNOWN"
              ]
            },
            "allowUnknownPhaseKeys": {
              "type": "boolean"
            },
            "phases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/phase"
              }
            },
            "partitionGroups": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/partitionGroup"
              }
            }
          }
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "promotion",
            "relegation",
            "continentalQualification",
            "tieBreak",
            "summary"
          ],
          "properties": {
            "promotion": {},
            "relegation": {},
            "continentalQualification": {},
            "tieBreak": {},
            "summary": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seedSchema",
            "seedGeneratedAt",
            "seedVerificationStatus",
            "observedPhaseKeys"
          ],
          "properties": {
            "seedSchema": {
              "type": "string",
              "minLength": 1
            },
            "seedGeneratedAt": {
              "type": "string",
              "format": "date-time"
            },
            "seedVerificationStatus": {
              "type": "string",
              "minLength": 1
            },
            "observedPhaseKeys": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
