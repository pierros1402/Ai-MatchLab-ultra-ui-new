{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-matchlab.autonomous-repair-execution-request-gate.v1",
  "title": "AI MatchLab Autonomous Repair Execution Request Gate V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "dayKey",
    "generatedAt",
    "role",
    "planFingerprint",
    "verificationFingerprint",
    "requestFingerprint",
    "requestState",
    "summary",
    "operationScope",
    "blockers",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "ai-matchlab.autonomous-repair-execution-request-gate.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "dayKey": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "const": "derived_read_only_execution_request_gate"
    },
    "planFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verificationFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requestFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requestState": {
      "enum": [
        "NO_ACTION_NO_OPERATIONS",
        "EXECUTION_REQUEST_ELIGIBLE",
        "BLOCKED_TARGET_VERIFICATION"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationCount",
        "verifiedOperationCount",
        "blockedOperationCount",
        "createCount",
        "replaceCount",
        "blockerCount",
        "requestableOperationCount"
      ],
      "properties": {
        "operationCount": { "type": "integer", "minimum": 0 },
        "verifiedOperationCount": { "type": "integer", "minimum": 0 },
        "blockedOperationCount": { "type": "integer", "minimum": 0 },
        "createCount": { "type": "integer", "minimum": 0 },
        "replaceCount": { "type": "integer", "minimum": 0 },
        "blockerCount": { "type": "integer", "minimum": 0 },
        "requestableOperationCount": { "type": "integer", "minimum": 0 }
      }
    },
    "operationScope": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "targetPath",
          "mutationMode",
          "preimageFingerprint",
          "verified"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "pattern": "^arpo_v1_[0-9a-f]{24}$"
          },
          "targetPath": {
            "type": "string",
            "minLength": 1
          },
          "mutationMode": {
            "enum": ["CREATE", "REPLACE"]
          },
          "preimageFingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "verified": {
            "type": "boolean"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "operationId",
          "targetPath"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "operationId": {
            "type": ["string", "null"]
          },
          "targetPath": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readOnly",
        "authorizationRequestEligible",
        "authorizationGranted",
        "filesystemWriteAuthorized",
        "repairAuthorized",
        "executionAuthorized",
        "rollbackExecutionAuthorized",
        "workflowMutationAuthorized"
      ],
      "properties": {
        "readOnly": { "const": true },
        "authorizationRequestEligible": { "type": "boolean" },
        "authorizationGranted": { "const": false },
        "filesystemWriteAuthorized": { "const": false },
        "repairAuthorized": { "const": false },
        "executionAuthorized": { "const": false },
        "rollbackExecutionAuthorized": { "const": false },
        "workflowMutationAuthorized": { "const": false }
      }
    }
  }
}
