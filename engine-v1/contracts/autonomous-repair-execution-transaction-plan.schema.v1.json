{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-matchlab.autonomous-repair-execution-transaction-plan.v1",
  "title": "AI MatchLab Autonomous Repair Execution Transaction Plan V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "dayKey",
    "generatedAt",
    "role",
    "bindings",
    "transactionFingerprint",
    "repairClassScope",
    "summary",
    "operations",
    "safety",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "ai-matchlab.autonomous-repair-execution-transaction-plan.v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "dayKey": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "const": "derived_read_only_bounded_execution_transaction_plan"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizationId",
        "nonce",
        "authorizationFingerprint",
        "requestFingerprint",
        "planFingerprint",
        "verificationFingerprint",
        "materialResolutionFingerprint",
        "replayKey"
      ],
      "properties": {
        "authorizationId": {
          "type": "string",
          "pattern": "^arauth_v2_[0-9a-f]{32}$"
        },
        "nonce": {
          "type": "string",
          "pattern": "^arnonce_v2_[0-9a-f]{64}$"
        },
        "authorizationFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "requestFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "planFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verificationFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "materialResolutionFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "replayKey": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "transactionFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repairClassScope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ACQUIRE_VERIFIED_FINAL_EVIDENCE",
          "REBUILD_HISTORY_ELIGIBLE_ROW",
          "REBUILD_PUBLICATION_CANONICAL_ROW"
        ]
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationCount",
        "createCount",
        "replaceCount",
        "publicationMutationCount",
        "totalPostimageBytes"
      ],
      "properties": {
        "operationCount": {
          "type": "integer",
          "minimum": 1
        },
        "createCount": {
          "type": "integer",
          "minimum": 0
        },
        "replaceCount": {
          "type": "integer",
          "minimum": 0
        },
        "publicationMutationCount": {
          "type": "integer",
          "minimum": 0
        },
        "totalPostimageBytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "candidateDecisionId",
          "repairClass",
          "targetPath",
          "mutationMode",
          "preimage",
          "postimage",
          "rollback"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "pattern": "^arpo_v1_[0-9a-f]{24}$"
          },
          "candidateDecisionId": {
            "type": "string",
            "pattern": "^arpd_v1_[0-9a-f]{24}$"
          },
          "repairClass": {
            "enum": [
              "ACQUIRE_VERIFIED_FINAL_EVIDENCE",
              "REBUILD_HISTORY_ELIGIBLE_ROW",
              "REBUILD_PUBLICATION_CANONICAL_ROW"
            ]
          },
          "targetPath": {
            "type": "string",
            "minLength": 1
          },
          "mutationMode": {
            "enum": [
              "CREATE",
              "REPLACE"
            ]
          },
          "preimage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "targetExists",
              "sha256",
              "bytes",
              "preimageFingerprint"
            ],
            "properties": {
              "targetExists": {
                "type": "boolean"
              },
              "sha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "preimageFingerprint": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "postimage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceKind",
              "materialFingerprint",
              "publicationBundleFingerprint",
              "publicationRole",
              "contentSha256",
              "contentBytes"
            ],
            "properties": {
              "sourceKind": {
                "enum": [
                  "TARGET_MATERIAL",
                  "PUBLICATION_MUTATION"
                ]
              },
              "materialFingerprint": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "publicationBundleFingerprint": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "publicationRole": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "contentSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "contentBytes": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "rollback": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "strategy"
            ],
            "properties": {
              "strategy": {
                "enum": [
                  "DELETE_CREATED_TARGET",
                  "RESTORE_PREIMAGE"
                ]
              }
            }
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pinnedTrustReverificationRequired",
        "preimageReverificationRequired",
        "externalGlobalLockRequired",
        "atomicReplayConsumeRequired",
        "durableExternalJournalRequired",
        "verifiedBackupRequiredForReplace",
        "fsyncedTempRequired",
        "postimageVerificationRequired",
        "reverseRollbackRequired",
        "crashRecoveryRollbackOnly",
        "allTargetsAppliedOrVerifiedRestored"
      ],
      "properties": {
        "pinnedTrustReverificationRequired": {
          "const": true
        },
        "preimageReverificationRequired": {
          "const": true
        },
        "externalGlobalLockRequired": {
          "const": true
        },
        "atomicReplayConsumeRequired": {
          "const": true
        },
        "durableExternalJournalRequired": {
          "const": true
        },
        "verifiedBackupRequiredForReplace": {
          "const": true
        },
        "fsyncedTempRequired": {
          "const": true
        },
        "postimageVerificationRequired": {
          "const": true
        },
        "reverseRollbackRequired": {
          "const": true
        },
        "crashRecoveryRollbackOnly": {
          "const": true
        },
        "allTargetsAppliedOrVerifiedRestored": {
          "const": true
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readOnly",
        "filesystemWriteAuthorized",
        "repairAuthorized",
        "executionAuthorized",
        "rollbackExecutionAuthorized",
        "replayConsumptionAuthorized",
        "workflowMutationAuthorized"
      ],
      "properties": {
        "readOnly": {
          "const": true
        },
        "filesystemWriteAuthorized": {
          "const": false
        },
        "repairAuthorized": {
          "const": false
        },
        "executionAuthorized": {
          "const": false
        },
        "rollbackExecutionAuthorized": {
          "const": false
        },
        "replayConsumptionAuthorized": {
          "const": false
        },
        "workflowMutationAuthorized": {
          "const": false
        }
      }
    }
  }
}
