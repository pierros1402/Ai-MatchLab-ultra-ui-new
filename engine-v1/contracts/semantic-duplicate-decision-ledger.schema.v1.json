{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-matchlab.local/contracts/semantic-duplicate-decision-ledger.schema.v1.json",
  "title": "AI MatchLab Semantic Duplicate Decision Ledger V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ledgerVersion",
    "generatedAt",
    "sourceBinding",
    "policy",
    "summary",
    "teamIdentities",
    "decisions"
  ],
  "properties": {
    "schema": {
      "const": "ai-matchlab.semantic-duplicate-decision-ledger.v1"
    },
    "ledgerVersion": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p0bCommit",
        "sourceBundleSha256",
        "sourceManifestSha256",
        "clusterIndexSha256",
        "masterAuditSha256",
        "fixtureIdsSha256"
      ],
      "properties": {
        "p0bCommit": {
          "$ref": "#/$defs/gitSha"
        },
        "sourceBundleSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "clusterIndexSha256": {
          "$ref": "#/$defs/sha256"
        },
        "masterAuditSha256": {
          "$ref": "#/$defs/sha256"
        },
        "fixtureIdsSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryApplicationAuthorized",
        "mutationAllowed",
        "retainedRepositoryFixtureIdSelection",
        "productionGlobalClubIdBinding",
        "providerTeamIdCoverage",
        "providerPreferenceMaySelectTruth",
        "scoreOrTerminalConflictMustBeEvidenceResolved"
      ],
      "properties": {
        "repositoryApplicationAuthorized": {
          "const": false
        },
        "mutationAllowed": {
          "const": false
        },
        "retainedRepositoryFixtureIdSelection": {
          "const": "DEFERRED_UNTIL_PRODUCTION_GLOBAL_CLUB_ID_BINDING"
        },
        "productionGlobalClubIdBinding": {
          "const": "UNBOUND"
        },
        "providerTeamIdCoverage": {
          "const": "NOT_AVAILABLE_IN_SOURCE_EVIDENCE_BUNDLE"
        },
        "providerPreferenceMaySelectTruth": {
          "const": false
        },
        "scoreOrTerminalConflictMustBeEvidenceResolved": {
          "const": true
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionRecords",
        "sourceFixtureIds",
        "ledgerTeamIdentities",
        "confirmedSemanticDuplicates",
        "reviewCandidatesResolved",
        "scoreConflicts",
        "terminalStatusConflicts",
        "truthConflictUnionResolved",
        "repositoryFixtureIdSelectionsDeferred",
        "productionGlobalClubIdsBound"
      ],
      "properties": {
        "decisionRecords": {
          "const": 53
        },
        "sourceFixtureIds": {
          "const": 106
        },
        "ledgerTeamIdentities": {
          "const": 70
        },
        "confirmedSemanticDuplicates": {
          "const": 53
        },
        "reviewCandidatesResolved": {
          "const": 1
        },
        "scoreConflicts": {
          "const": 6
        },
        "terminalStatusConflicts": {
          "const": 5
        },
        "truthConflictUnionResolved": {
          "const": 7
        },
        "repositoryFixtureIdSelectionsDeferred": {
          "const": 53
        },
        "productionGlobalClubIdsBound": {
          "const": 0
        }
      }
    },
    "teamIdentities": {
      "type": "array",
      "minItems": 70,
      "items": {
        "$ref": "#/$defs/teamIdentity"
      },
      "maxItems": 70
    },
    "decisions": {
      "type": "array",
      "minItems": 53,
      "maxItems": 53,
      "items": {
        "$ref": "#/$defs/decision"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "dayKey": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "nullableInteger": {
      "type": [
        "integer",
        "null"
      ]
    },
    "teamIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ledgerTeamIdentityKey",
        "preferredDisplayName",
        "aliases",
        "productionGlobalClubId",
        "productionBindingStatus",
        "scope",
        "identityHash"
      ],
      "properties": {
        "ledgerTeamIdentityKey": {
          "type": "string",
          "pattern": "^p0cteam_[a-f0-9]{20}$"
        },
        "preferredDisplayName": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "productionGlobalClubId": {
          "type": "null"
        },
        "productionBindingStatus": {
          "const": "UNBOUND_SOURCE_BUNDLE_HAS_NO_PROVIDER_TEAM_IDS"
        },
        "scope": {
          "const": "P0C_SEMANTIC_DUPLICATE_ALIAS_GRAPH"
        },
        "identityHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryFixtureId",
        "providerFamily",
        "providerFixtureId",
        "providerHomeTeamId",
        "providerAwayTeamId",
        "providerTeamIdAvailability",
        "homeName",
        "awayName",
        "kickoffUtc",
        "status",
        "rawStatus",
        "scoreHome",
        "scoreAway",
        "evidencePath",
        "claimLabel",
        "homeTeamIdentityKey",
        "awayTeamIdentityKey"
      ],
      "properties": {
        "repositoryFixtureId": {
          "type": "string",
          "minLength": 1
        },
        "providerFamily": {
          "type": "string",
          "minLength": 1
        },
        "providerFixtureId": {
          "type": [
            "string",
            "null"
          ]
        },
        "providerHomeTeamId": {
          "type": "null"
        },
        "providerAwayTeamId": {
          "type": "null"
        },
        "providerTeamIdAvailability": {
          "const": "NOT_AVAILABLE_IN_SOURCE_EVIDENCE_BUNDLE"
        },
        "homeName": {
          "type": "string",
          "minLength": 1
        },
        "awayName": {
          "type": "string",
          "minLength": 1
        },
        "kickoffUtc": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "rawStatus": {
          "type": [
            "string",
            "null"
          ]
        },
        "scoreHome": {
          "$ref": "#/$defs/nullableInteger"
        },
        "scoreAway": {
          "$ref": "#/$defs/nullableInteger"
        },
        "evidencePath": {
          "type": "string",
          "minLength": 1
        },
        "claimLabel": {
          "enum": [
            "A",
            "B"
          ]
        },
        "homeTeamIdentityKey": {
          "type": "string",
          "pattern": "^p0cteam_[a-f0-9]{20}$"
        },
        "awayTeamIdentityKey": {
          "type": "string",
          "pattern": "^p0cteam_[a-f0-9]{20}$"
        }
      }
    },
    "externalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "sourceClass",
        "publisher",
        "title",
        "url",
        "retrievedAt",
        "supports"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1
        },
        "sourceClass": {
          "enum": [
            "PRIMARY_COMPETITION",
            "PRIMARY_CLUB",
            "SECONDARY_DIRECT_SCOREBOARD",
            "SECONDARY_DIRECT_MATCH_REPORT"
          ]
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "retrievedAt": {
          "$ref": "#/$defs/dayKey"
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "clusterOrdinal",
        "dayKey",
        "leagueSlug",
        "sourceAuditClassification",
        "scoreConflict",
        "terminalStatusConflict",
        "canonicalFixtureIdentityKey",
        "homeTeamIdentityKey",
        "awayTeamIdentityKey",
        "sourceFixtures",
        "identityDecision",
        "repositoryFixtureIdDecision",
        "truthDecision",
        "externalEvidence",
        "propagationImpact",
        "applicationAuthorization",
        "immutableDecisionHash"
      ],
      "properties": {
        "decisionId": {
          "type": "string",
          "pattern": "^p0cdup_[a-f0-9]{24}$"
        },
        "clusterOrdinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 53
        },
        "dayKey": {
          "$ref": "#/$defs/dayKey"
        },
        "leagueSlug": {
          "type": "string",
          "minLength": 1
        },
        "sourceAuditClassification": {
          "enum": [
            "HIGH_CONFIDENCE_SEMANTIC_DUPLICATE",
            "POSSIBLE_DUPLICATE_REQUIRES_REVIEW"
          ]
        },
        "scoreConflict": {
          "type": "boolean"
        },
        "terminalStatusConflict": {
          "type": "boolean"
        },
        "canonicalFixtureIdentityKey": {
          "type": "string",
          "pattern": "^p0cfixture_[a-f0-9]{24}$"
        },
        "homeTeamIdentityKey": {
          "type": "string",
          "pattern": "^p0cteam_[a-f0-9]{20}$"
        },
        "awayTeamIdentityKey": {
          "type": "string",
          "pattern": "^p0cteam_[a-f0-9]{20}$"
        },
        "sourceFixtures": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/sourceFixture"
          }
        },
        "identityDecision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "verificationMethod",
            "reasonCodes",
            "evidenceRefs"
          ],
          "properties": {
            "status": {
              "const": "CONFIRMED_SEMANTIC_DUPLICATE"
            },
            "verificationMethod": {
              "type": "string",
              "minLength": 1
            },
            "reasonCodes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "evidenceRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "repositoryFixtureIdDecision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "retainedRepositoryFixtureId",
            "suppressedRepositoryFixtureIds",
            "reasonCode"
          ],
          "properties": {
            "status": {
              "const": "DEFERRED_UNTIL_PRODUCTION_GLOBAL_CLUB_ID_BINDING"
            },
            "retainedRepositoryFixtureId": {
              "type": "null"
            },
            "suppressedRepositoryFixtureIds": {
              "type": "array",
              "maxItems": 0
            },
            "reasonCode": {
              "const": "provider_preference_alone_cannot_select_canonical_truth_identity"
            }
          }
        },
        "truthDecision": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "verificationMethod",
            "terminalStatus",
            "scoreHome",
            "scoreAway",
            "nonPlayedStatus",
            "evidenceRefs"
          ],
          "properties": {
            "status": {
              "enum": [
                "NO_CONFLICT_RECORDED",
                "RESOLVED_FINAL",
                "RESOLVED_NON_PLAYED"
              ]
            },
            "verificationMethod": {
              "type": "string",
              "minLength": 1
            },
            "terminalStatus": {
              "type": [
                "string",
                "null"
              ]
            },
            "scoreHome": {
              "$ref": "#/$defs/nullableInteger"
            },
            "scoreAway": {
              "$ref": "#/$defs/nullableInteger"
            },
            "nonPlayedStatus": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidenceRefs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "externalEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalEvidence"
          }
        },
        "propagationImpact": {
          "type": "object"
        },
        "applicationAuthorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repositoryApplicationAuthorized",
            "mutationAllowed",
            "writePlanGenerated",
            "reason"
          ],
          "properties": {
            "repositoryApplicationAuthorized": {
              "const": false
            },
            "mutationAllowed": {
              "const": false
            },
            "writePlanGenerated": {
              "const": false
            },
            "reason": {
              "const": "P0C_LEDGER_FOUNDATION_READ_ONLY"
            }
          }
        },
        "immutableDecisionHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
